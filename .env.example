# Local Postgres (Cloud Agents generate this automatically)
DATABASE_URL=

# NextAuth session secrets (generate any long random string)
NEXTAUTH_SECRET=
AUTH_SECRET=

# --- AI brain (need ONE of these) ---
# Default is OpenAI. Switch with LLM_PROVIDER=openai | anthropic | xai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=

# --- Web research ---
# Exa finds current pages about competitors, markets, experts, and news.
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
